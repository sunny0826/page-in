# Maintainer: guoxudong <guoxudong.dev@gmail.com>
pkgname=pagein-git
pkgver=0.0.1.r5.g742f45f3
pkgrel=1
pkgdesc="In-place text editor for local HTML files and presentation projects"
arch=('x86_64')
url="https://github.com/sunny0826/page-in"
license=('MIT')
depends=('gtk3' 'webkit2gtk-4.1')
makedepends=('git' 'nodejs' 'npm' 'rust')
provides=('pagein')
conflicts=('pagein')
source=("$pkgname::git+$url.git"
        'pagein.desktop')
sha256sums=('SKIP'
            'f6d23b3a0a01350866983f1d66497a28cee195f9e037c539c12253c9084c243b')

pkgver() {
  cd "$pkgname"
  git describe --long --tags --abbrev=8 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' ||
    printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=8 HEAD)"
}

build() {
  cd "$pkgname"
  npm ci
  npm run tauri -- build --no-bundle
}

package() {
  cd "$pkgname"
  install -Dm755 src-tauri/target/release/pagein "$pkgdir/usr/bin/pagein"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 ../pagein.desktop "$pkgdir/usr/share/applications/pagein.desktop"
  install -Dm644 src-tauri/icons/32x32.png "$pkgdir/usr/share/icons/hicolor/32x32/apps/pagein.png"
  install -Dm644 src-tauri/icons/64x64.png "$pkgdir/usr/share/icons/hicolor/64x64/apps/pagein.png"
  install -Dm644 src-tauri/icons/128x128.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/pagein.png"
  install -Dm644 src-tauri/icons/128x128@2x.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/pagein.png"
  install -Dm644 src-tauri/icons/icon.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/pagein.png"
}
